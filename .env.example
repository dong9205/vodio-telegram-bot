# Ingestion modes. For MTProto group archiving, set BOT_ENABLED=false and MT_ENABLED=true.
BOT_ENABLED=true
MT_ENABLED=false

# Telegram Bot mode.
TELEGRAM_BOT_TOKEN=1234567890:replace-with-your-bot-token

# Optional custom Telegram Bot API base URL, useful for a local telegram-bot-api server.
# TELEGRAM_API_BASE_URL=http://192.168.1.10:8081

# Comma-separated Telegram user IDs allowed to use this bot.
ALLOWED_USER_IDS=123456789,987654321

# Optional relay target using the Bot API chat ID (usually negative). When set,
# the bot forwards incoming text and media here instead of downloading files itself.
# Run MTProto at the same time and monitor this chat to bypass Bot API download limits.
# BOT_RELAY_CHAT_ID=-1001234567890

# MTProto user account mode. Get api_id and api_hash from https://my.telegram.org/apps.
# MT_API_ID=123456
# MT_API_HASH=replace-with-your-api-hash
# MT_PHONE=+8613800000000
# MT_PASSWORD=optional-2fa-password
# MT_SESSION_FILE=/data/telegram-session/session.json
# Accepts either the raw positive MTProto peer_id or the negative Bot API chat id.
# Leave empty or 0 on first run only if you need to discover the target id from logs.
# MT_INBOX_CHAT_ID=123456789

# Directory inside the container. docker-compose.yml mounts local storage here.
STORAGE_ROOT=/data/telegram-videos

# Embedded local monitoring dashboard.
DASHBOARD_ENABLED=true
DASHBOARD_ADDR=127.0.0.1:9090
# DASHBOARD_STATE_FILE=/data/telegram-videos/.dashboard/tasks.json

# Optional HTTP proxy for Bot API, Bot API file downloads, and AI calls.
# MTProto media downloads are currently direct and do not use this proxy.
# HTTP_PROXY_URL=http://127.0.0.1:7890

# AI provider. Currently only "openai" compatible Chat Completions API is supported.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-with-your-api-key

# Optional OpenAI-compatible base URL. Leave empty for official OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model. Defaults to gpt-4o-mini.
# AI_MODEL=gpt-4o-mini
